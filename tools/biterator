#!/usr/bin/env python3

import sys


def print_set_bits(x: int):
    bits = []
    bit = 0
    y = x
    while y:
        if y & 1:
            bits.append(bit)

        bit += 1
        y = y >> 1

    print(f"{x}: " + " ".join(map(str, reversed(bits))))


for arg in sys.argv[1:]:
    print_set_bits(int(arg, 0))
